# Nexus 2k26 Technical-Quiz Environment Configuration

# Server Port (default 3000, platforms like Render/Railway set this automatically)
PORT=3000

# Environment mode: development or production
NODE_ENV=development

# Public facing URL (e.g. https://nexus2k26.example.com or http://localhost:3000)
PUBLIC_BASE_URL=http://localhost:3000

# Google Forms Embed URL (Form -> Send -> <> Embed HTML -> src URL)
GOOGLE_FORM_EMBED_URL=https://docs.google.com/forms/d/e/1FAIpQLSfCodIuM_rofOGgpEA73S2antoOotI68Ut9ynI50vHOVL6pRg/viewform?embedded=true

# Admin password for the /admin dashboard (use a strong random secret)
ADMIN_PASSWORD=change_this_to_a_strong_secret

# Cookie secure flag (set to true when running under HTTPS in production)
COOKIE_SECURE=false

# Directory where SQLite database and video recordings are stored
DATA_DIR=./data

# Maximum allowed size per upload in MB
MAX_RECORDING_MB=500
